AI_PROVIDER=ninearm
AI_TOOL_MODE=auto
# Live AI kill switch. The unified TurnPlan router is the only live path; "off" makes live turns answer
# truthfully that AI is temporarily unavailable (use Demo). Any other value or unset = router on.
BIZTANIA_DYNAMIC_QUERY=on
BIZTANIA_DYNAMIC_PLANNER_TIMEOUT_MS=15000
AI_DISABLE_THINKING=true
NINEARM_BASE_URL=https://gateway.9arm.co/v1
NINEARM_MODEL=qwen3.8-27b-fp8
NINEARM_API_KEY=
NINEARM_CAPABILITIES_JSON=
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_TOOL_CALLS_PER_TURN=8
AI_MAX_STEPS_PER_TURN=6
USE_LOCAL_DEMO_DATA=true
DB_PATH=.local/demo.sqlite
DEMO_BUSINESS_DATE=2026-10-01
# Optional local approval epoch, combined with automatic source hashing. Vercel requires its Git SHA.
BIZTANIA_RELEASE_REVISION=
DEMO_SESSION_SECRET=
DEMO_ACCESS_CODE=
DEMO_SESSION_REQUEST_LIMIT=20
DEMO_IP_REQUEST_LIMIT=60
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
