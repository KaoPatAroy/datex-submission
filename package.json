{
  "name": "biztania-ai-concierge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "release:scan": "node scripts/release-scan.mjs --require-bundle",
    "seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "probe": "node --conditions=react-server --import tsx scripts/probe-ninearm.ts",
    "db:local:start": "node --import tsx scripts/local-supabase.ts start",
    "db:local:stop": "node --import tsx scripts/local-supabase.ts stop",
    "db:local:status": "node --import tsx scripts/local-supabase.ts status",
    "db:local:reset": "node --import tsx scripts/local-supabase.ts reset",
    "db:local:seed": "node --import tsx scripts/local-supabase.ts seed",
    "db:local:digest": "node --import tsx scripts/local-supabase.ts digest",
    "db:local:bootstrap": "node --import tsx scripts/local-supabase.ts bootstrap",
    "db:local:seed-check": "node --import tsx scripts/local-supabase.ts seed-check",
    "db:local:verify": "node --import tsx scripts/local-supabase.ts verify",
    "db:local:manifest": "node --import tsx scripts/local-supabase.ts manifest",
    "test:pg:acceptance": "node --import tsx scripts/local-supabase.ts acceptance",
    "test:pg": "node --import tsx scripts/local-supabase.ts test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "better-sqlite3": "13.0.3",
    "next": "16.3.8",
    "openai": "7.25.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "5.0.3"
  },
  "engines": { "node": ">=22.13.0" }
}
